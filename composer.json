{
    "name": "innoboxrr/affiliate-saas",
    "description": "Homero Raul Vargas Cruz",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\AffiliateSaas\\": "src/",
            "Innoboxrr\\AffiliateSaas\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\AffiliateSaas\\Providers\\AppServiceProvider",
                "Innoboxrr\\AffiliateSaas\\Providers\\AuthServiceProvider",
                "Innoboxrr\\AffiliateSaas\\Providers\\EventServiceProvider",
                "Innoboxrr\\AffiliateSaas\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\AffiliateSaas\\Tests\\": "tests/"
        }
    },
    "require": {
        "innoboxrr/support": "^2.0",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "maatwebsite/excel": "Necesario para las exportaciones del paquete (^3.1)."
    }
}
